# Base URL of the UI application under test
BASE_URL=https://www.saucedemo.com

# Standard, working credentials for the demo storefront
USERNAME=standard_user
PASSWORD=secret_sauce

# Additional SauceDemo demo accounts used by negative auth tests
LOCKED_USERNAME=locked_out_user
PROBLEM_USERNAME=problem_user

# Base URL of the REST API under test (FakeStoreAPI - public e-commerce API)
API_BASE_URL=https://fakestoreapi.com

# Optional: enables AI-powered failure analysis when set.
# Without this, the framework falls back to heuristic (rule-based) analysis.
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
